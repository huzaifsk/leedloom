# Create an OAuth 2.0 Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an authorized Google OAuth redirect URI.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Any long random secret; used to encrypt Gmail tokens in an HTTP-only cookie.
# Generate one with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
